<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>SeleniumTutorial</groupId>
  <artifactId>SeleniumTutorial</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  
  <profiles>

    <profile>
        <id>E2EFramework</id>
        <properties>
            <suiteXmlFile>resources/E2EFramework.xml</suiteXmlFile>
        </properties>
        <build>
    <plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.5.5</version>

            <configuration>
                <suiteXmlFiles>
                    <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                </suiteXmlFiles>
            </configuration>

        </plugin>
    </plugins>
</build>
    </profile>

    <profile>
        <id>E2EFrameworkValidation</id>
        <properties>
            <suiteXmlFile>resources/E2EValidation.xml</suiteXmlFile>
        </properties>
        <build>
    <plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.5.5</version>

            <configuration>
                <suiteXmlFiles>
                    <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                </suiteXmlFiles>
            </configuration>

        </plugin>
    </plugins>
</build>
    </profile>

    <!-- Cucumber Execution -->
    <profile>
        <id>CucumberTest</id>

        <build>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>

                    <configuration>
                        <includes>
                            <include>**/*Runner.java</include>
                        </includes>
                    </configuration>

                </plugin>
            </plugins>
        </build>
    </profile>

</profiles>


  
  
